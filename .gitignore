# Godot 4+ specific ignores
.godot/
/android/

# Local assistant data
.workbuddy/

# Mixamo source FBX files are not redistributed
assets/anim_src/*.fbx
assets/anim_src/*.fbx.import

# Third-party source asset packs are kept local only
assets/anim_src/*/

# Development screenshots and reference renders are kept local only
docs/**/*.png
docs/**/*.png.import

# Character deliverables live under art/ only. No stray models or boards at repo root.
/*.glb
/*.glb.import
/*.png
/*.png.import

# Third-party reference models (Warcraft fan remake, Hircine, etc.) are licensed
# for internal shape study only. Never commit them to a public repo.
/art/references/
